# =============================================================================
# SkillUp — Environment Variables Template
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your real values
#   docker compose --env-file .env up -d
#
# NEVER commit the real .env file (it is gitignored).
# For production, inject these as host/container environment variables or
# store them in a secrets manager (AWS SSM, HashiCorp Vault, etc.).
# =============================================================================

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local     # prod in production
SERVER_PORT=8088

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Application user (created by scripts/01_create_db_and_user.sql)
DB_USERNAME=skillup_app
DB_PASSWORD=skillup_app_pass

# Postgres SUPERUSER password — needed by the Keycloak Docker container to
# create its own schema inside skillup_db.
POSTGRES_PASSWORD=your_postgres_superuser_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380                  # 6380 to avoid clashing with other Redis instances
REDIS_PASSWORD=skillup_redis_pass

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ENABLED=false           # true in prod — enables RealKeycloakAdminService
KEYCLOAK_BASE_URL=http://localhost:8070
KEYCLOAK_REALM=skillup
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_pass

# skillup-portal Keycloak client (used for both parent portal AND teacher portal login)
KEYCLOAK_PORTAL_CLIENT_ID=skillup-portal
KEYCLOAK_PORTAL_CLIENT_SECRET=   # obtain from Keycloak Admin → Clients → Credentials

# JWT validation (Spring Security resource server)
KEYCLOAK_ISSUER_URI=http://localhost:8070/realms/skillup
KEYCLOAK_JWK_URI=http://localhost:8070/realms/skillup/protocol/openid-connect/certs

# ── MinIO / S3 File Storage ───────────────────────────────────────────────────
STORAGE_ENABLED=false            # true in prod — enables S3StorageService
STORAGE_ENDPOINT=http://localhost:9010   # MinIO S3 API (docker-compose maps 9000→9010)
STORAGE_ACCESS_KEY=skillup_minio
STORAGE_SECRET_KEY=skillup_minio_pass
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=skillup-uploads
STORAGE_PRESIGN_EXPIRY=15        # presigned URL lifetime in minutes

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# Obtain from https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ENABLED=false           # true in prod — enables MetaWhatsAppSender
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=        # e.g. 123456789012345
WHATSAPP_ACCESS_TOKEN=           # permanent system-user token (never expires)
WHATSAPP_FROM_NAME=SkillUp Tuition Centre

# ── Portal / Teacher local dev bypass ─────────────────────────────────────────
# Pass X-Portal-Account-ID or X-Staff-ID headers instead of a JWT.
# Set to true ONLY for local development — NEVER in production.
PORTAL_LOCAL_DEV_BYPASS=false
