# =============================================================================
# SkillUp — Environment Variables Template
# Copy this file to .env (gitignored) and fill in your values.
#
# Local dev:  copy to .env  — Spring Boot picks up DB_USERNAME / DB_PASSWORD
# Production: set these as EC2 environment variables or AWS SSM Parameter Store
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USERNAME=skillup_app
DB_PASSWORD=skillup_app_pass      # Change to a strong password in all non-local envs
POSTGRES_PASSWORD=your_postgres_superuser_password   # Used by Keycloak Docker container

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=skillup_redis_pass

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://localhost:8070/realms/skillup
KEYCLOAK_JWK_URI=http://localhost:8070/realms/skillup/protocol/openid-connect/certs

# ── AWS (leave blank for local — MinIO is used instead) ──────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=skillup-uploads-local

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8088
